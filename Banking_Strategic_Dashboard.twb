  <worksheets>
    <worksheet name='AIU by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_customers+ (mitron_bank)' name='federated.02sbdt30hibaiw123mctc1e8jz89' />
          </datasources>
          <datasource-dependencies datasource='federated.02sbdt30hibaiw123mctc1e8jz89'>
            <column caption='Customer Segmentation' datatype='string' name='[Calculation_0375209063677952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [avg_income] &gt;= 80000 THEN &quot;Upper Class&quot;&#13;&#10;ELSEIF [avg_income] &gt;= 45000 THEN &quot;Middle Class&quot;&#13;&#10;ELSE &quot;Lower Class&quot;&#13;&#10;END' />
            </column>
            <column caption='Avg Spending' datatype='real' name='[Calculation_0375209063940097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([spend]) / COUNTD([month])' />
            </column>
            <column caption='Avg Income Utilization' datatype='real' name='[Calculation_0375209067032579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0375209063940097] / SUM([avg_income])' />
            </column>
            <column caption='Month (copy)' datatype='date' name='[Calculation_0528316049686528]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE TRIM([month])&#13;&#10;WHEN &quot;May&quot; THEN MAKEDATE(2024,5,1)&#13;&#10;WHEN &quot;June&quot; THEN MAKEDATE(2024,6,1)&#13;&#10;WHEN &quot;July&quot; THEN MAKEDATE(2024,7,1)&#13;&#10;WHEN &quot;August&quot; THEN MAKEDATE(2024,8,1)&#13;&#10;WHEN &quot;September&quot; THEN MAKEDATE(2024,9,1)&#13;&#10;WHEN &quot;October&quot; THEN MAKEDATE(2024,10,1)&#13;&#10;END' />
            </column>
            <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal' />
            <column caption='Avg Income' datatype='integer' name='[avg_income]' role='measure' type='quantitative' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Delhi NCR&quot;' value='&quot;New Delhi&quot;' />
              </semantic-values>
            </column>
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='Marital Status' datatype='string' name='[marital status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0528316049686528]' derivation='Month' name='[mn:Calculation_0528316049686528:ok]' pivot='key' type='ordinal' />
